@page "/"
@inject IYouTubeService YouTubeService
@inject IRequestCounterService RequestCounter
@inject IHistoryService HistoryService
@inject IFavoritesService FavoritesService
@inject SearchStateService SearchState
@inject SearchHistoryService SearchHistory
@inject IJSRuntime JS
@inject PlayerStateService PlayerState
@inject NavigationManager Navigation

<PageTitle>Videos suchen – EasyTube</PageTitle>

<div class="search-header">
        <h1 class="app-title">🎬 EasyTube</h1>
    <p class="app-subtitle">Einfach Videos schauen</p>

        <div class="search-row">
            <div class="autocomplete-wrapper">
                <label class="visually-hidden" for="video-search">Videos suchen</label>
                <input class="search-input"
                       id="video-search"
                       type="search"
                       placeholder="Was möchtest du ansehen?"
                       value="@SearchText"
                       @onkeydown="OnKeyDown"
                       @oninput="OnInput"
                       autocomplete="off" />

                @if (!string.IsNullOrEmpty(SearchText))
                {
                    <button class="input-clear" @onclick="ClearSearch" aria-label="Suchfeld leeren">✕</button>
                }
                @if (Suggestions.Count > 0)
                {
                    <div class="autocomplete-dropdown" role="listbox" aria-label="Frühere Suchbegriffe">
                        @foreach (var suggestion in Suggestions)
                        {
                            <button class="autocomplete-item" role="option" @onclick="() => SelectSuggestion(suggestion)">
                                🕐 @suggestion
                            </button>
                        }
                    </div>
                }
            </div>

            <button class="btn-primary"
                    @onclick="SearchAsync"
                    disabled="@(IsLoading || string.IsNullOrWhiteSpace(SearchText))">
                Suchen
            </button>
        </div>

        @if (RemainingSearches <= 10)
        {
            <div class="request-counter" style="color: @CounterColor">
                Heute sind noch @RemainingSearches neue Suchen möglich.
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <div class="spinner-box" role="status" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <span>Wird gesucht...</span>
        </div>
    }
    else if (HasError)
    {
        <div class="state-box" role="alert">
            <div class="state-icon" aria-hidden="true">⚠️</div>
            <div class="state-title">@ErrorMessage</div>
            <button class="btn-secondary" @onclick="SearchAsync">Noch einmal versuchen</button>
        </div>
    }
    else if (HasNoResults)
    {
        <div class="state-box">
            <div class="state-icon" aria-hidden="true">🔍</div>
            <div class="state-title">Nichts gefunden.</div>
            <div class="state-subtitle">Versuche einen anderen Suchbegriff.</div>
        </div>
    }
    else if (Results.Count == 0)
    {
        <div class="category-section">
            <h2 class="category-title">Beliebte Themen</h2>
            <p class="category-subtitle">Tippe auf ein Thema, um passende Videos zu finden.</p>
            <div class="category-grid">
                @foreach (var category in Categories)
                {
                    <button class="category-card" @onclick="() => SearchCategoryAsync(category)">
                        @category
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="video-list">
            @foreach (var video in VisibleResults)
            {
                <article class="video-card">
                    <button class="video-open" @onclick="() => OpenVideo(video)" aria-label="@($"Video abspielen: {video.Title}")">
                        <img class="video-thumbnail" src="@video.ThumbnailUrl" alt="" />
                        <span class="video-info">
                            <span class="video-title">@video.Title</span>
                            <span class="video-channel">@video.ChannelName</span>
                        </span>
                    </button>
                    <button class="btn-card-action" @onclick="() => ToggleFavoriteAsync(video)">
                        @(FavoriteIds.Contains(video.VideoId) ? "★ Gemerkt" : "☆ Merken")
                    </button>
                </article>
            }

            @if (VisibleResultCount < Results.Count)
            {
                <button class="btn-load-more" @onclick="ShowMoreResults">
                    Weitere Videos anzeigen
                </button>
            }
        </div>
    }

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="snackbar" role="status" aria-live="polite">
        <span>@StatusMessage</span>
    </div>
}

@code {
    private const int ResultsPerPage = 12;
    private static readonly string[] Categories =
    [
        "🎵 Musik",
        "📰 Nachrichten",
        "🐾 Tiere",
        "🍳 Kochen"
    ];

    private string SearchText { get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private bool HasError { get; set; }
    private bool HasNoResults { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private List<VideoItem> Results { get; set; } = [];
    private List<string> Suggestions { get; set; } = [];
    private HashSet<string> FavoriteIds { get; set; } = [];
    private int VisibleResultCount { get; set; } = ResultsPerPage;
    private string StatusMessage { get; set; } = string.Empty;

    private IEnumerable<VideoItem> VisibleResults => Results.Take(VisibleResultCount);
    private int RemainingSearches => Math.Max(0, RequestCounter.DailyLimit - RequestCounter.TodayCount);

    private string CounterColor => RequestCounter.TodayCount switch
    {
        var n when n >= RequestCounter.DailyLimit * 0.9 => "#C62828",
        var n when n >= RequestCounter.DailyLimit * 0.7 => "#E65100",
        _ => "#2E7D32"
    };

    protected override async Task OnInitializedAsync()
    {
        await RequestCounter.LoadAsync();
        FavoriteIds = (await FavoritesService.GetAllAsync())
            .Select(video => video.VideoId)
            .ToHashSet();

        // Letzte Suche wiederherstellen
        if (SearchState.LastResults.Count > 0)
        {
            SearchText = SearchState.LastSearchText;
            Results = SearchState.LastResults;
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        if (SearchText.Length >= 2)
            Suggestions = await SearchHistory.GetSuggestionsAsync(SearchText);
        else
            Suggestions = [];
    }

    private async Task SelectSuggestion(string suggestion)
    {
        SearchText = suggestion;
        Suggestions = [];
        await JS.BlurActiveElementAsync();
        await SearchAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Suggestions = [];
            await JS.BlurActiveElementAsync();
            await SearchAsync();
        }
        else if (e.Key == "Escape")
        {
            Suggestions = [];
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(SearchText) || IsLoading)
            return;

        IsLoading = true;
        HasError = false;
        HasNoResults = false;
        ErrorMessage = string.Empty;
        Results = [];
        Suggestions = [];
        VisibleResultCount = ResultsPerPage;

        try
        {
            var results = await YouTubeService.SearchAsync(SearchText);
            Results = results.ToList();
            HasNoResults = Results.Count == 0;

            if (Results.Count > 0)
            {
                await RequestCounter.IncrementAsync();
                await SearchHistory.AddAsync(SearchText);
                SearchState.LastSearchText = SearchText;
                SearchState.LastResults = Results;
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            HasError = true;
            ErrorMessage = "Tageslimit erreicht. Bitte morgen erneut versuchen.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            HasError = true;
            ErrorMessage = "Die Videosuche ist gerade nicht verfügbar. Bitte später erneut versuchen.";
        }
        catch (HttpRequestException)
        {
            HasError = true;
            ErrorMessage = "Keine Internetverbindung. Bitte WLAN prüfen.";
        }
        catch (TaskCanceledException)
        {
            HasError = true;
            ErrorMessage = "Die Suche dauert zu lange. Bitte versuche es erneut.";
        }
        catch (System.Text.Json.JsonException)
        {
            HasError = true;
            ErrorMessage = "Die Suchergebnisse konnten nicht geladen werden. Bitte versuche es erneut.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenVideo(VideoItem video)
    {
        PlayerState.Play(video, Navigation.ToBaseRelativePath(Navigation.Uri));
        var entry = WatchHistoryEntry.FromVideoItem(video);
        await HistoryService.AddAsync(entry);
    }

    private async Task ToggleFavoriteAsync(VideoItem video)
    {
        if (FavoriteIds.Contains(video.VideoId))
        {
            await FavoritesService.RemoveAsync(video.VideoId);
            FavoriteIds.Remove(video.VideoId);
            StatusMessage = "Video wurde aus „Meine Videos“ entfernt.";
        }
        else
        {
            await FavoritesService.AddAsync(video);
            FavoriteIds.Add(video.VideoId);
            StatusMessage = "Video wurde unter „Meine Videos“ gespeichert.";
        }
    }

    private async Task SearchCategoryAsync(string category)
    {
        SearchText = category[(category.IndexOf(' ') + 1)..];
        Suggestions = [];
        await JS.BlurActiveElementAsync();
        await SearchAsync();
    }

    private void ShowMoreResults()
    {
        VisibleResultCount = Math.Min(VisibleResultCount + ResultsPerPage, Results.Count);
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
        Suggestions = [];
    }

}
