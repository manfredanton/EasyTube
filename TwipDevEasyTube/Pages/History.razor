@page "/verlauf"
@inject IHistoryService HistoryService
@inject SearchHistoryService SearchHistory;
@inject IJSRuntime JS;
@implements IDisposable

<PageTitle>Verlauf – EasyTube</PageTitle>

@if (CurrentVideo is not null)
{
    <div class="player-header">
        <button class="btn-back" @onclick="ClosePlayer">← Zurück zum Verlauf</button>
        <span class="player-title">@CurrentVideo.Title</span>
    </div>

    <iframe class="player-embed"
            title="@($"Video: {CurrentVideo.Title}")"
            src="@CurrentVideo.EmbedUrl"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
            allowfullscreen>
    </iframe>

    <div class="player-info">
        <div class="player-video-title">@CurrentVideo.Title</div>
        <div class="player-channel">@CurrentVideo.ChannelName</div>
    </div>
}
else
{
    <div class="history-header">
        <button class="btn-display" @onclick="OpenSearchHistory">🧹 Suchbegriffe</button>
        <h1 class="history-title">Zuletzt angesehen</h1>
        @if (Entries.Count > 0)
        {
            <button class="btn-clear" @onclick="ClearAllAsync">Alles löschen</button>
        }
    </div>

    @if (Entries.Count > 0)
    {
        <div style="padding: 10px 16px; background: var(--bg-white);">
            <div class="autocomplete-wrapper">
                <input class="search-input"
                       aria-label="Im Verlauf suchen"
                       type="search"
                       placeholder="Im Verlauf suchen..."
                       value="@FilterText"
                       @oninput="OnFilterInput"
                       @onkeydown="OnFilterKeyDown"
                       autocomplete="off"
                       style="width: 100%; height: 64px; font-size: 28px;" />

                @if (!string.IsNullOrEmpty(FilterText))
                {
                    <button class="input-filterclear" @onclick="ClearFilterSearch" aria-label="Verlaufssuche leeren">✕</button>
                }
            </div>
        </div>
    }
    @if (ShowConfirmDialog)
    {
        <div class="dialog-overlay" @onkeydown="OnDialogKeyDown">
            <div class="dialog-box" role="dialog" aria-modal="true" aria-labelledby="clear-dialog-title" tabindex="-1">
                <div class="dialog-icon" aria-hidden="true">🗑️</div>
                <div class="dialog-title" id="clear-dialog-title">Verlauf löschen</div>
                <div class="dialog-message">Möchtest du deinen gesamten Verlauf löschen?</div>
                <div class="dialog-buttons">
                    <button class="btn-cancel" autofocus @onclick="() => ShowConfirmDialog = false">Abbrechen</button>
                    <button class="btn-confirm" @onclick="ConfirmClear">Ja, löschen</button>
                </div>
            </div>
        </div>
    }
    @if (ShowSearchHistoryDialog)
    {
        <div class="dialog-overlay" @onkeydown="OnDialogKeyDown">
            <div class="dialog-box dialog-search-history" role="dialog" aria-modal="true" aria-labelledby="search-history-title" tabindex="-1">
                <div class="dialog-icon" aria-hidden="true">🧹</div>
                <div class="dialog-title" id="search-history-title">Gespeicherte Suchbegriffe</div>
                @if (SearchTerms.Count == 0)
                {
                    <div class="dialog-message">Noch keine Suchbegriffe gespeichert.</div>
                }
                else
                {
                    <div class="dialog-search-history-list">
                        @foreach (var term in SearchTerms)
                        {
                            <div class="dialog-search-history-item">
                                <span>@term</span>
                                <button class="btn-delete" aria-label="@($"Suchbegriff „{term}“ löschen")" @onclick="() => DeleteSearchTermAsync(term)">✕</button>
                            </div>
                        }
                    </div>
                }
                <div class="dialog-search-history-buttons">
                    @if (SearchTerms.Count > 0)
                    {
                        <button class="btn-confirm" @onclick="ClearSearchHistoryAsync">Alle löschen</button>
                    }
                    <button class="btn-cancel" @onclick="() => ShowSearchHistoryDialog = false">Schließen</button>
                </div>
            </div>
        </div>
    }
    @if (IsLoading)
    {
        <div class="spinner-box" role="status" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <span>Wird geladen...</span>
        </div>
    }
    else if (Entries.Count == 0)
    {
        <div class="state-box">
            <div class="state-icon" aria-hidden="true">🕐</div>
            <div class="state-title">Noch nichts angesehen.</div>
            <div class="state-subtitle">Videos die du abgespielt hast, erscheinen hier.</div>
        </div>
    }
    else
    {
        <div class="video-list">
            @foreach (var entry in FilteredEntries)
            {
                <article class="video-card">
                    <button class="video-open" @onclick="() => OpenVideo(entry)" aria-label="@($"Video erneut abspielen: {entry.Title}")">
                        <img class="video-thumbnail" src="@entry.ThumbnailUrl" alt="" />
                        <span class="video-info">
                            <span class="video-title">@entry.Title</span>
                            <span class="video-channel">@entry.ChannelName</span>
                            <span class="video-date">@entry.WatchedAtFormatted</span>
                        </span>
                    </button>
                    <button class="btn-card-action" @onclick="() => DeleteEntryAsync(entry)">🗑️ Entfernen</button>
                </article>
            }
        </div>
    }
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="snackbar" role="status" aria-live="polite">
        <span>@StatusMessage</span>
        @if (CanUndo)
        {
            <button @onclick="UndoAsync">Rückgängig</button>
        }
    </div>
}

@code {
    private List<WatchHistoryEntry> Entries { get; set; } = [];
    private bool IsLoading { get; set; } = true;
    private VideoItem? CurrentVideo { get; set; }

    private bool ShowSearchHistoryDialog { get; set; }
    private List<string> SearchTerms { get; set; } = [];

    private string FilterText { get; set; } = string.Empty;
    private WatchHistoryEntry? LastDeletedEntry { get; set; }
    private List<WatchHistoryEntry> LastClearedEntries { get; set; } = [];
    private string StatusMessage { get; set; } = string.Empty;
    private bool CanUndo => LastDeletedEntry is not null || LastClearedEntries.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private List<WatchHistoryEntry> FilteredEntries =>
    FilterText.Length >= 2
        ? Entries.Where(e =>
            e.Title.Contains(FilterText, StringComparison.OrdinalIgnoreCase) ||
            e.ChannelName.Contains(FilterText, StringComparison.OrdinalIgnoreCase))
          .ToList()
        : Entries;

    private void OnFilterInput(ChangeEventArgs e)
    {
        FilterText = e.Value?.ToString() ?? string.Empty;
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        FilterText = string.Empty;
        var entries = await HistoryService.GetAllAsync();
        Entries = entries.ToList();
        IsLoading = false;
    }

    private async Task OpenVideo(WatchHistoryEntry entry)
    {
        CurrentVideo = new VideoItem
        {
            VideoId = entry.VideoId,
            Title = entry.Title,
            ChannelName = entry.ChannelName,
            ThumbnailUrl = entry.ThumbnailUrl
        };

        // Eintrag neu speichern damit er oben erscheint
        var updated = WatchHistoryEntry.FromVideoItem(CurrentVideo);
        await HistoryService.AddAsync(updated);
        await LoadAsync();
    }

    private void ClosePlayer()
    {
        CurrentVideo = null;
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await JS.BlurActiveElementAsync();
    }

    private async Task DeleteEntryAsync(WatchHistoryEntry entry)
    {
        LastDeletedEntry = entry;
        LastClearedEntries = [];
        await HistoryService.RemoveAsync(entry.VideoId);
        await LoadAsync();
        ShowStatus("Video wurde aus dem Verlauf entfernt.");
    }

    private bool ShowConfirmDialog { get; set; }

    private void ClearAllAsync()
    {
        ShowConfirmDialog = true;
    }

    private async Task ConfirmClear()
    {
        ShowConfirmDialog = false;
        LastClearedEntries = Entries.ToList();
        LastDeletedEntry = null;
        await HistoryService.ClearAllAsync();
        await LoadAsync();
        ShowStatus("Der Verlauf wurde gelöscht.");
    }

    private async Task OpenSearchHistory()
    {
        SearchTerms = await SearchHistory.GetAllAsync();
        ShowSearchHistoryDialog = true;
    }

    private async Task DeleteSearchTermAsync(string term)
    {
        await SearchHistory.RemoveAsync(term);
        SearchTerms = await SearchHistory.GetAllAsync();
    }

    private async Task ClearSearchHistoryAsync()
    {
        await SearchHistory.ClearAllAsync();
        SearchTerms = [];
    }

    private void ClearFilterSearch()
    {
        FilterText = string.Empty;
    }

    private async Task UndoAsync()
    {
        if (LastDeletedEntry is not null)
        {
            await HistoryService.AddAsync(LastDeletedEntry);
            LastDeletedEntry = null;
        }
        else if (LastClearedEntries.Count > 0)
        {
            foreach (var entry in LastClearedEntries.AsEnumerable().Reverse())
                await HistoryService.AddAsync(entry);

            LastClearedEntries = [];
        }

        await LoadAsync();
        ShowStatus("Der Verlauf wurde wiederhergestellt.", allowUndo: false);
    }

    private void OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;

        ShowConfirmDialog = false;
        ShowSearchHistoryDialog = false;
    }

    private CancellationTokenSource? StatusCancellation { get; set; }

    private void ShowStatus(string message, bool allowUndo = true)
    {
        StatusCancellation?.Cancel();
        StatusCancellation?.Dispose();
        StatusCancellation = new CancellationTokenSource();
        StatusMessage = message;
        _ = ClearStatusAfterDelayAsync(StatusCancellation.Token, allowUndo);
    }

    private async Task ClearStatusAfterDelayAsync(CancellationToken cancellationToken, bool allowUndo)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(8), cancellationToken);
            StatusMessage = string.Empty;
            if (allowUndo)
            {
                LastDeletedEntry = null;
                LastClearedEntries = [];
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        StatusCancellation?.Cancel();
        StatusCancellation?.Dispose();
    }
}
